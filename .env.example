# ============================================================
#  .env.example — copy to .env at repo root and fill in values
# ============================================================
#  Without these, the server still boots, but emails fall through to a
#  JSON-transport stub that logs mail to the console (responses return fake:true).

# ── Frontend (Vite picks up VITE_ prefixed vars) ──────────────
VITE_API_URL=/api

# ── Backend ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=ddash_super_secret_change_in_production_2024

# ── App URL (used in weekly-report email links) ───────────────
APP_URL=http://localhost:3000

# ── SMTP (for real email delivery) ────────────────────────────
# Gmail example:
#   1. Enable 2-step verification on the Google account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-char password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=D-DASH <you@gmail.com>
# For port 465 the transport auto-enables TLS (secure=true).
# Other providers: Mailtrap / Ethereal / Postmark / SendGrid / SES — swap host/port/user/pass accordingly.
